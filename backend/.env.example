# PostgreSQL initialization prerequisites:
# - PGDATABASE and PGUSER must already exist.
# - PGUSER must be able to connect to PGDATABASE and create tables, types,
#   and indexes in it.
# - PostgreSQL commonly provides the postgres role, but it has no universal
#   default password. Leave PGPASSWORD empty only when the server permits
#   passwordless authentication.
# - Replace these defaults with an existing application role and password
#   when applicable.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=basketcase

# MongoDB initialization prerequisites:
# - The default URL assumes local MongoDB authentication is disabled.
# - If authentication is enabled, provide credentials and the correct
#   authSource in MONGODB_URL.
# - The MongoDB user must be allowed to create collections and indexes in
#   MONGODB_DATABASE.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=basketcase

HOST=127.0.0.1
PORT=8000
APP_ENV=development
